{
  "name": "autonomous-multi-agent-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start-js": "node src/server.js",
    "build": "tsc",
    "start": "tsx src/server.ts",
    "dev": "nodemon --exec tsx src/server.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run board\"",
    "board": "tsx src/board/server.ts",
    "test": "tsx src/test.ts"
  },
  "dependencies": {
    "@langchain/community": "^0.0.53",
    "@langchain/core": "^0.1.50",
    "@langchain/langgraph": "^0.0.20",
    "@langchain/ollama": "^0.0.2",
    "@types/socket.io": "^3.0.2",
    "axios": "^1.6.2",
    "concurrently": "^9.2.1",
    "dotenv": "^16.3.1",
    "duck-duck-scrape": "^2.2.7",
    "express": "^4.18.2",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.4",
    "nodemon": "^3.0.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
