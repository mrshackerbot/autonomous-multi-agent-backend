    "@langchain/textsplitters": "^1.0.1",
    "@types/socket.io": "^3.0.2",
    "axios": "^1.13.5",
    "cheerio": "^1.2.0",
    "chromadb": "^3.3.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
